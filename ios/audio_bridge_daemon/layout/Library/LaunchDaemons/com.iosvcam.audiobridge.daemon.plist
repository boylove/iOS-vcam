<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.iosvcam.audiobridge.daemon</string>
    <key>Disabled</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/libexec/iosvcam/iosvcam_audio_bridge_daemon</string>
    </array>
    <key>KeepAlive</key>
    <false/>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/var/mobile/Library/Logs/iOSVCAMAudioBridgeDaemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Library/Logs/iOSVCAMAudioBridgeDaemon.err.log</string>
</dict>
</plist>
