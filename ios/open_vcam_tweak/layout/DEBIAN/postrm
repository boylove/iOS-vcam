#!/bin/sh
# Remove the RootHide mirror copy the postinst placed in the real ElleKit scan
# dir (see postinst / memory roothide-tweakinject-path), then restart mediaserverd
# so it drops the tweak.
rm -f /usr/lib/TweakInject/OpenVCam.dylib /usr/lib/TweakInject/OpenVCam.plist 2>/dev/null || true
killall -9 mediaserverd 2>/dev/null || true
exit 0
