#!/bin/sh
# OpenVCam hooks mediaserverd's capture graph (BWNodeOutput -emitSampleBuffer:)
# and overwrites the camera's OWN image buffer IN PLACE via VTPixelTransferSession,
# then passes the original sample buffer downstream, like the original vcamera.
# (The audio / AudioUnitRender hook is temporarily out of this build.) Restart
# mediaserverd so the tweak loads; it respawns automatically.
#
# Also reset videodecoderd: repeated mediaserverd SIGKILLs can leave its H264
# decode-session pool exhausted, which makes the first VTDecompressionSessionCreate
# fail with err 1100 (no video overwrite until reset). See EXECUTION-PLAN §4.3.

# RootHide compatibility: this deb is built rootless, so files land under
# /var/jb/Library/MobileSubstrate/DynamicLibraries. On RootHide, ElleKit ONLY
# scans /usr/lib/TweakInject (= /Library/MobileSubstrate/DynamicLibraries symlink),
# and NEVER the /var/jb path — so the tweak silently never injects into
# mediaserverd (no [OpenVCam] logs, real camera shown). Mirror it into the real
# scan dir. The guard skips this on pure-rootless (Dopamine) devices, which have
# no writable /usr/lib/TweakInject. See memory roothide-tweakinject-path.
#
# ELLEKIT-SAFE MIRROR (do NOT clobber RootHide's own copy): when this deb is
# installed through a package manager (Sileo/Zebra), RootHide's AutoPatcher ALREADY
# mirrors + re-signs the dylib into /usr/lib/TweakInject and records it with a
# `<dylib>.roothidepatch` marker (see VCAMERA_DEB_REVERSE_ANALYSIS.md §4.1). If we
# then `cp -f` our raw /var/jb copy over that managed file, we (a) replace RootHide's
# patched/signed binary with an unpatched one and (b) leave RootHide's patch record
# pointing at a file it no longer owns — which is what makes ElleKit error when the
# package is later removed. So only place our manual copy when the scan dir does NOT
# already have the file (the raw `dpkg -i` case, where AutoPatcher never ran). When
# RootHide already mirrored it, leave it entirely to RootHide.
SRC="/var/jb/Library/MobileSubstrate/DynamicLibraries"
if [ -d /usr/lib/TweakInject ] && [ -f "$SRC/OpenVCam.dylib" ]; then
    if [ ! -e /usr/lib/TweakInject/OpenVCam.dylib ] \
       && [ ! -e /usr/lib/TweakInject/OpenVCam.dylib.roothidepatch ]; then
        cp -f "$SRC/OpenVCam.dylib"  /usr/lib/TweakInject/OpenVCam.dylib  2>/dev/null || true
        cp -f "$SRC/OpenVCam.plist" /usr/lib/TweakInject/OpenVCam.plist 2>/dev/null || true
    fi
fi

killall -9 videodecoderd 2>/dev/null || true
killall -9 mediaserverd 2>/dev/null || true
exit 0
