#!/bin/sh
# OpenVCam hooks mediaserverd's capture graph (BWNodeOutput -emitSampleBuffer:)
# and overwrites the camera's OWN image buffer IN PLACE via VTPixelTransferSession,
# then passes the original sample buffer downstream, like the original vcamera.
# (The audio / AudioUnitRender hook is temporarily out of this build.) Restart
# mediaserverd so the tweak loads; it respawns automatically.
#
# Also reset videodecoderd: repeated mediaserverd SIGKILLs can leave its H264
# decode-session pool exhausted, which makes the first VTDecompressionSessionCreate
# fail with err 1100 (no video overwrite until reset). See EXECUTION-PLAN §4.3.

# RootHide compatibility. ElleKit only scans /usr/lib/TweakInject. On some rootless
# layouts the deb's files land under /var/jb/... which is a DIFFERENT directory, so
# the tweak must be mirrored into the scan dir or it never injects (memory
# roothide-tweakinject-path).
#
# CRITICAL (device-confirmed 2026-07-08): on THIS RootHide device `/var/jb` is a
# symlink to `/`, so /var/jb/Library/MobileSubstrate/DynamicLibraries,
# /Library/MobileSubstrate/DynamicLibraries and /usr/lib/TweakInject ALL resolve to
# the SAME directory. In that case dpkg already installs the dylib straight into the
# scan dir, so mirroring copies a file onto itself AND — far worse — the postrm
# removing "the mirror" deletes the package's OWN dpkg-tracked file. On a Sileo
# upgrade dpkg unpacks the new dylib, then runs the OLD postrm, which wiped the
# freshly-unpacked file -> phantom install (dpkg says installed, file gone, no
# injection, real camera shown). So mirror ONLY when the scan dir is a genuinely
# DIFFERENT directory from where dpkg installed the file.
SRC="/var/jb/Library/MobileSubstrate/DynamicLibraries"
DST="/usr/lib/TweakInject"
if [ -d "$DST" ] && [ -f "$SRC/OpenVCam.dylib" ]; then
    SRC_REAL="$(readlink -f "$SRC" 2>/dev/null || echo "$SRC")"
    DST_REAL="$(readlink -f "$DST" 2>/dev/null || echo "$DST")"
    if [ "$SRC_REAL" != "$DST_REAL" ]; then
        # Genuinely separate dirs (e.g. some pure-rootless layouts). Only place our
        # copy when the scan dir does not already have the file and RootHide's
        # AutoPatcher has not already managed it (a <dylib>.roothidepatch marker):
        # clobbering RootHide's patched/signed copy is what made ElleKit error.
        if [ ! -e "$DST/OpenVCam.dylib" ] && [ ! -e "$DST/OpenVCam.dylib.roothidepatch" ]; then
            cp -f "$SRC/OpenVCam.dylib"  "$DST/OpenVCam.dylib"  2>/dev/null || true
            cp -f "$SRC/OpenVCam.plist" "$DST/OpenVCam.plist" 2>/dev/null || true
        fi
    fi
    # else: same directory -> dpkg already placed the file in the scan dir; nothing
    # to mirror, and postrm must NOT remove it (see postrm).
fi

killall -9 videodecoderd 2>/dev/null || true
killall -9 mediaserverd 2>/dev/null || true
exit 0
