#!/bin/sh

case "$1" in
    remove|purge)
        TWEAK_DIR="/usr/lib/TweakInject"
        rm -f "$TWEAK_DIR/iOSVCAMAudioBridgeSafe.dylib.roothidepatch" 2>/dev/null || true
        rm -f "$TWEAK_DIR/iOSVCAMAudioBridgeSafe.dylib" 2>/dev/null || true
        rm -f "$TWEAK_DIR/iOSVCAMAudioBridgeSafe.plist" 2>/dev/null || true
        ;;
esac

exit 0
