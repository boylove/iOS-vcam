#!/bin/sh
set -e

TWEAK_DIR="/usr/lib/TweakInject"
DYLIB="$TWEAK_DIR/iOSVCAMAudioBridgeSafe.dylib"
PLIST="$TWEAK_DIR/iOSVCAMAudioBridgeSafe.plist"
PATCH_LINK="$TWEAK_DIR/iOSVCAMAudioBridgeSafe.dylib.roothidepatch"
PATCH_TARGET="/usr/lib/DynamicPatches/AutoPatches.dylib"

if [ -d "$TWEAK_DIR" ]; then
    if [ -f "$DYLIB" ] && [ -f "$PATCH_TARGET" ] && [ ! -e "$PATCH_LINK" ]; then
        ln -s "$PATCH_TARGET" "$PATCH_LINK" 2>/dev/null || true
    fi

    if [ -f "$PLIST" ]; then
        cat > "$PLIST" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Filter</key>
    <dict>
        <key>Bundles</key>
        <array>
            <string>com.zhiliaoapp.musically</string>
            <string>com.apple.mediaserverd</string>
        </array>
        <key>Executables</key>
        <array>
            <string>TikTok</string>
            <string>mediaserverd</string>
        </array>
    </dict>
</dict>
</plist>
EOF
        chmod 644 "$PLIST" 2>/dev/null || true
    fi
fi

exit 0
