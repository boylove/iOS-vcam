#!/bin/sh

TWEAK_DIR="/usr/lib/TweakInject"
PKGMIRROR_DIR="/var/mobile/Library/pkgmirror/Library/MobileSubstrate/DynamicLibraries"

case "$1" in
    remove|purge)
        rm -f "$TWEAK_DIR/iOSVCAMAudioBridgeSystemHook.dylib" 2>/dev/null || true
        rm -f "$TWEAK_DIR/iOSVCAMAudioBridgeSystemHook.plist" 2>/dev/null || true
        rm -f "$TWEAK_DIR/iOSVCAMAudioBridgeSystemHook.dylib.roothidepatch" 2>/dev/null || true
        rm -f "$PKGMIRROR_DIR/iOSVCAMAudioBridgeSystemHook.dylib" 2>/dev/null || true
        rm -f "$PKGMIRROR_DIR/iOSVCAMAudioBridgeSystemHook.plist" 2>/dev/null || true
        ;;
esac

exit 0
